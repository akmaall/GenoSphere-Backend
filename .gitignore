.env
.venv/
__pycache__/
.pytest_cache/
*.pyc

# Data genom pengguna & keluaran analisis: JANGAN pernah di-commit (privasi data genomik)
uploads/

# ==========================================
# SECRET / ENVIRONMENT
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# PYTHON VIRTUAL ENVIRONMENT
# ==========================================
.venv/
venv/
env/

# ==========================================
# PYTHON CACHE
# ==========================================
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ==========================================
# LOCAL USER DATA
# ==========================================
uploads/

# ==========================================
# LOCAL DATABASE AND BACKUP
# ==========================================
*.dump
*.backup
*.sqlite
*.sqlite3

# ==========================================
# LOGS AND TEMPORARY FILES
# ==========================================
*.log
*.tmp
*.pid
.DS_Store
Thumbs.db

# ==========================================
# LARGE AI MODEL / LOCAL RUNTIME
# ==========================================
models/
ollama/
tools/ollama/
*.gguf

# ==========================================
# OFFLINE PACKAGE CACHE
# ==========================================
wheelhouse/
wheels/

# ==========================================
# INCLUDE BUNDLED OLLAMA RUNTIME
# Managed by Git LFS
# ==========================================
!tools/ollama/
!tools/ollama/**
!tools/ollama/models/
!tools/ollama/models/**
!tools/ollama/**/*.gguf

# Exclude generated Ollama runtime logs
/tools/ollama/*.log
/tools/ollama/**/*.log

# NVIDIA CUDA libraries withheld pending redistribution review
/tools/ollama/lib/ollama/cuda_v12/
/tools/ollama/lib/ollama/cuda_v13/
