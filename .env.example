# Salin menjadi .env (JANGAN di-commit). Isi sesuai lingkungan WSL kamu.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=isi-password-postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gwas

# Wajib. Buat dengan:  openssl rand -hex 32
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:3000"]

# Pemulihan kata sandi. Tautan mengarah ke FRONTEND_URL/reset-password?token=...
FRONTEND_URL=http://localhost:3000
RESET_TOKEN_EXPIRE_MINUTES=30
# SMTP opsional. Biarkan SMTP_HOST kosong saat pengembangan: tautan pemulihan dicetak di log uvicorn.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@genosphere.local
SMTP_STARTTLS=true
# ---- Modul GWAS (semua opsional; hapus tanda # untuk mengubah) ----
# STORAGE_DIR=uploads            # tempat berkas pengguna & hasil analisis (jangan di-commit)
# PLINK2_BIN=/usr/local/bin/plink2
# GEMMA_BIN=/usr/local/bin/gemma
# MAX_UPLOAD_MB=2048             # batas maksimum satu file (MiB)
# MAX_DATASET_UPLOAD_MB=6144     # kuota gabungan berkas dalam satu dataset (MiB)
# UPLOAD_DISK_RESERVE_MB=1024    # disk kosong yang disisakan untuk server
# MAX_CONCURRENT_JOBS=2          # batas global maksimum analisis; PostgreSQL advisory lock lintas worker
# ANALYSIS_MEMORY_RESERVE_MB=512
# ANALYSIS_MEMORY_PER_JOB_MB=2048
# ANALYSIS_DISK_RESERVE_MB=1024
# PCA_FALLBACK_MEMORY_LIMIT_MB=1024
# PCA_FALLBACK_MEMORY_FRACTION=0.35
# MAX_PLOT_POINTS=100000         # batas titik tampilan Manhattan/QQ; data sumber tetap lengkap

# Interpretasi statistik AI (opsional; GWAS tetap berjalan tanpa API key)
# AI_PROVIDER=openai_compatible
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4.1-mini
# AI_TIMEOUT_SECONDS=60
# AI_MAX_ATTEMPTS=3
# AI_MAX_OUTPUT_TOKENS=2500
# AI_TOP_SNP_COUNT=50
# AI_MAX_CONCURRENT_JOBS=2
PLINK2_BIN=tools/bin/plink2
GEMMA_BIN=tools/bin/gemma
AI_PROVIDER=openai_compatible
AI_API_BASE_URL=http://127.0.0.1:11434/v1
AI_API_KEY=ollama
AI_MODEL=qwen3:1.7b
AI_TIMEOUT_SECONDS=240
AI_MAX_ATTEMPTS=1
AI_MAX_OUTPUT_TOKENS=256
AI_TOP_SNP_COUNT=5
AI_MAX_CONCURRENT_JOBS=1
MAX_CONCURRENT_JOBS=1
ANALYSIS_MEMORY_RESERVE_MB=1024

# GenoSphere local AI tuning (Qwen3 1.7B)
AI_JOB_DEADLINE_SECONDS=360
